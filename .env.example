# 复制为 .env，在本机填写。不要将真实密钥放入前端代码或提交到仓库。
SILICONFLOW_API_KEY=
# 从硅基流动控制台复制完整模型ID。文本模型用于材料核对，多模态模型用于图片文字识别。
SILICONFLOW_TEXT_MODEL=Qwen/Qwen3.5-35B-A3B
SILICONFLOW_VISION_MODEL=Qwen/Qwen3.5-35B-A3B

# 本地默认值；服务器通过反向代理开放 8083，后端仍可仅监听本机。
PORT=8266
HOST=127.0.0.1
# 服务器部署时设置浏览器实际访问的完整地址，例如 https://example.com:8083
PUBLIC_ORIGIN=
